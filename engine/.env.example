# ─── Engine environment ───────────────────────────────────────────────────────
# Copy to `.env` for local development. Never commit `.env`.

# Application
APP_NAME="starterkit-engine"
NODE_ENV="development"            # development | test | production
# DEV_ROLE_SWITCH="true"         # triple-click the sign-in heading to pick a role. Ignored in production.
# OTP_PEPPER=""                  # required in production; at least 16 characters. Development has a local default.
HOST="0.0.0.0"
PORT="3000"

# Public URLs (no trailing slash)
API_URL="http://localhost:3000"   # where this engine is reachable (used for OAuth callback)
WEB_URL="http://localhost:5173"   # where the frontend is served (default redirect target)

# CORS: comma-separated allowlist of origins that may call the API with cookies.
# Defaults to WEB_URL when unset. Outside production, loopback origins
# (localhost / 127.0.0.1 on any port) are always allowed, so this is only
# needed for non-local origins. Never use "*" with credentialed requests.
CORS_ORIGINS="http://localhost:5173"

# Session cookie
SESSION_TTL_DAYS="7"
COOKIE_SAME_SITE="lax"            # lax | strict | none (use "none" when web and api are on different sites; requires https)
# COOKIE_DOMAIN=".example.com"    # optional; share the cookie across subdomains

# Database
# Driver is auto-detected: Neon URLs use the HTTP driver (works on Workers),
# everything else uses postgres.js over TCP (local Docker, RDS, Supabase, ...).
DATABASE_URL="postgres://postgres:postgres@localhost:5432/starterkit"
# DATABASE_DRIVER="postgres"      # postgres | neon (override auto-detection)

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: ${API_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Private object storage (Cloudflare R2 or another S3 API). Leave all four
# empty in development; the engine then keeps objects in memory and signs
# short-lived links through this API. Production refuses learner photos
# until all four are set. Never commit real values.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""
# R2_ENDPOINT=""               # optional; defaults to the account R2 endpoint

# Runtime behaviour
LOG_LEVEL="debug"                 # debug | info | warn | error | silent
LOG_FORMAT="pretty"               # pretty | json
DEBUG_API="false"                 # log every RPC call with payloads
VALIDATE_RESPONSES="true"         # validate handler output against the inferred schema
MAX_BODY_BYTES="1048576"          # 1 MiB request body limit for JSON endpoints

# SMS (Africa's Talking). Leave unset in development and test: the engine logs
# the text instead of calling the gateway. Tests never call the gateway.
# Set the delivery-report URL to ${API_URL}/api/webhooks/sms/africastalking
# and send the same secret in the x-ikiraro-sms-secret header or ?token=.
# SMS_USERNAME=""
# SMS_API_KEY=""
# SMS_SENDER_ID=""                # optional Rwandan sender id
# SMS_SANDBOX="false"
# SMS_FALLBACK_USERNAME=""        # optional second account; used when the first cannot be reached
# SMS_FALLBACK_API_KEY=""
# SMS_FALLBACK_SENDER_ID=""
# SMS_WEBHOOK_SECRET=""           # required before delivery receipts are accepted
# SMS_DAILY_CAP="8"               # notification texts per person per Kigali day; a config row overrides this
