# ─── Production secrets for the Hubfly space deployment ──────────────────────
# Copy to `engine/.env.production` (git-ignored) and fill in, then run
# `make deploy-secrets`. Each value is stored as a secret variable of the
# container; none of them enters the image or a committed file.
# Non-secret settings (URLs, cookie policy, logging) live in hubfly.build.json.

DATABASE_URL=""                 # Postgres connection string (sslmode=require)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
CLOUDINARY_URL=""               # cloudinary://<key>:<secret>@<cloud>

# At least 16 characters each: `openssl rand -base64 48`.
# Changing CREDENTIAL_SIGNING_KEY makes badges signed with the old key read as
# not authentic.
OTP_PEPPER=""
CREDENTIAL_SIGNING_KEY=""
